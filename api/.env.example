# Kopieren nach .env und ausfüllen. Die .env-Datei nie ins Git-Repo hochladen.

# Langer Zufallswert, z.B. mit: openssl rand -hex 32
SECRET=

# Adresse der App (für den Link in der Anmelde-E-Mail)
APP_URL=https://mlplugins.github.io/bauchgefuehl/

# Webseiten, die die API aufrufen dürfen (mit Komma getrennt)
ALLOWED_ORIGINS=https://mlplugins.github.io,https://bauchgefuehl.mlplugins.com

# Läuft hinter nginx/Caddy/Traefik → 1 (für korrekte IP-Begrenzung)
TRUST_PROXY=1

# Google-Anmeldung: OAuth-Client-ID aus der Google Cloud Console (leer = ausgeschaltet)
GOOGLE_CLIENT_ID=

# E-Mail-Versand für die Anmeldecodes
SMTP_HOST=
SMTP_PORT=587
# 1 bei Port 465 (SSL), sonst 0 (STARTTLS)
SMTP_SECURE=0
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Bauchgefühl <noreply@mlplugins.com>
